# ==============================================================================
# Terraform Git Ignore
# ==============================================================================

# Local .terraform directories
**/.terraform/*
.terraform/
.terraform.lock.hcl.bak

# .tfstate files
*.tfstate
*.tfstate.*
*.tfstate.backup
*.tfstate.lock.info

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files with secrets (keep example templates)
*.tfvars
*.tfvars.json
!terraform.tfvars.example

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# Sensitive keys and credentials
*.pem
*.key
*.id_rsa
*.pub
ansible
ansible.pem
secrets.auto.tfvars

# Archive zip bundles
*.zip
*.tar.gz
*.tgz

# OS & IDE metadata
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
